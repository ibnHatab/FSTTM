[Unit]
Description=Nina: Piper's voice over HTTP (the Go engine's TTS), en_US-lessac-medium

[Service]
WorkingDirectory=%h/repo/FSTTM
ExecStart=%h/repo/FSTTM/.venv/bin/python -m piper.http_server -m models/en_US-lessac-medium.onnx --host 127.0.0.1 --port 5150
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
