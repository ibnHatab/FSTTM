[Unit]
Description=Nina: the home's rule engine (Metis, metis-worlds home) beside the conversation (fsttm-metis)
After=fsttm.service fsttm-go.service

[Service]
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=%h/repo/FSTTM
ExecStart=%h/repo/FSTTM/.venv/bin/fsttm-metis --config config.nuc.yaml
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
